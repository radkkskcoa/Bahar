# Local development defaults for docker-compose.base44.yml.
#
# These are placeholders so the stack boots before real credentials exist.
# The platform-delivered file (/run/base44/app.env) is listed AFTER this one in
# compose, so a value uploaded in the dashboard always overrides what is here.
#
# JWT_SECRET signs customer session cookies.
JWT_SECRET=local-dev-only-change-me
